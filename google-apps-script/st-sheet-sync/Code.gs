const ERP_SPREADSHEET_ID = '1BJTaqs76rJlYZHQFzDgpZiZJsBJCenKmbfenba1YdIw';
const ERP_SHEET_NAME = 'DATA BASE ERP';
const BOM_SPREADSHEET_ID = '1hA6a9EJsPOnhjbJUWtJmg7NSZGWaTKFAyvdEdmnZwuY';
const BOM_SHEET_NAME = 'BOM';
function runDailyStSync(){const token=PropertiesService.getScriptProperties().getProperty('ST_SYNC_TOKEN'),url=PropertiesService.getScriptProperties().getProperty('ST_EDGE_SYNC_URL');if(!token||!url)throw new Error('Thiếu ST_SYNC_TOKEN hoặc ST_EDGE_SYNC_URL');const response=UrlFetchApp.fetch(url,{method:'post',contentType:'application/json',payload:JSON.stringify({mode:'apply',token:token}),muteHttpExceptions:true});if(response.getResponseCode()<200||response.getResponseCode()>=300)throw new Error('Tự động đồng bộ thất bại: '+response.getContentText().slice(0,500));}
function installDailyStSync(){ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='runDailyStSync').forEach(t=>ScriptApp.deleteTrigger(t));ScriptApp.newTrigger('runDailyStSync').timeBased().everyDays(1).atHour(12).create();}
function doPost(event){try{const body=JSON.parse((event&&event.postData&&event.postData.contents)||'{}'),expected=PropertiesService.getScriptProperties().getProperty('ST_SYNC_TOKEN');if(!expected||body.token!==expected)return output_({ok:false,message:'unauthorized'});return output_(buildSnapshot_(body.include_history===true))}catch(error){return output_({ok:false,message:String(error&&error.message||error)})}}
function buildSnapshot_(includeHistory){const erpSheet=SpreadsheetApp.openById(ERP_SPREADSHEET_ID).getSheetByName(ERP_SHEET_NAME),bomSheet=SpreadsheetApp.openById(BOM_SPREADSHEET_ID).getSheetByName(BOM_SHEET_NAME);if(!erpSheet||!bomSheet)throw new Error('Không tìm thấy sheet nguồn ERP hoặc BOM.');const erpHeaders=erpSheet.getRange(1,1,1,erpSheet.getLastColumn()).getDisplayValues()[0],productColumn=headerColumn_(erpHeaders,'Prod. Material'),priceColumn=headerColumn_(erpHeaders,'Net Price'),rdColumn=includeHistory?headerColumnAny_(erpHeaders,['R/D date','R/D Date','RD date','Release date']):0;const erpRows=Math.max(0,erpSheet.getLastRow()-1),products=erpRows?erpSheet.getRange(2,productColumn,erpRows,1).getDisplayValues():[],prices=erpRows?erpSheet.getRange(2,priceColumn,erpRows,1).getDisplayValues():[],dates=includeHistory&&erpRows?erpSheet.getRange(2,rdColumn,erpRows,1).getValues():[];const bomHeaders=bomSheet.getRange(1,1,1,bomSheet.getLastColumn()).getDisplayValues()[0],modelColumn=headerColumn_(bomHeaders,'Model'),parentColumn=headerColumn_(bomHeaders,'Parent Code'),bomRows=Math.max(0,bomSheet.getLastRow()-1),models=bomRows?bomSheet.getRange(2,modelColumn,bomRows,1).getDisplayValues():[],parents=bomRows?bomSheet.getRange(2,parentColumn,bomRows,1).getDisplayValues():[],modelByCode=new Map();for(let i=0;i<bomRows;i++){const code=String(parents[i][0]||'').trim().toUpperCase(),model=String(models[i][0]||'').trim();if(/^GH96-[A-Z0-9]+$/.test(code)&&model)modelByCode.set(code,model)}const all=[],latest=new Map();for(let i=0;i<erpRows;i++){const code=String(products[i][0]||'').trim().toUpperCase(),netPrice=number_(prices[i][0]),modelName=modelByCode.get(code),rdDate=includeHistory?date_(dates[i][0]):'';if(!/^GH96-[A-Z0-9]+$/.test(code)||!modelName||!(netPrice>1000))continue;const row={product_code:code,model_name:modelName,product_type:type_(modelName),net_price:netPrice,rd_date:rdDate};latest.set(code,row);if(rdDate)all.push(row)}const dedup=new Map();all.sort((a,b)=>a.product_code.localeCompare(b.product_code)||a.rd_date.localeCompare(b.rd_date));for(const row of all)dedup.set(`${row.product_code}|${row.rd_date}|${row.net_price}`,row);const historyRows=[...dedup.values()].filter((row,i,a)=>!i||a[i-1].product_code!==row.product_code||a[i-1].net_price!==row.net_price);const rows=[...latest.values()].sort((a,b)=>a.model_name.localeCompare(b.model_name)||a.product_code.localeCompare(b.product_code));return{ok:true,generated_at:new Date().toISOString(),rows:rows,history_rows:historyRows,stats:{erp_rows:erpRows,unique_codes:latest.size,mapped_codes:rows.length,history_points:historyRows.length,bom_rows:bomRows}}}
function headerColumn_(headers,name){const i=headers.findIndex(v=>normalize_(v)===normalize_(name));if(i<0)throw new Error('Thiếu cột '+name);return i+1}function headerColumnAny_(headers,names){for(const n of names){const i=headers.findIndex(v=>normalize_(v)===normalize_(n));if(i>=0)return i+1}throw new Error('Thiếu cột R/D date');}function normalize_(v){return String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,' ').trim()}function number_(v){const x=String(v||'').trim().replace(/\s/g,'');if(!x)return NaN;if(/^\d{1,3}([.,]\d{3})+$/.test(x))return Number(x.replace(/[.,]/g,''));return Number(x.replace(',','.'))}function date_(v){if(v instanceof Date&&!isNaN(v))return Utilities.formatDate(v,Session.getScriptTimeZone(),'yyyy-MM-dd');const x=String(v||'').trim(),m=x.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})$/);return m?`${m[3]}-${('0'+m[2]).slice(-2)}-${('0'+m[1]).slice(-2)}`:''}function type_(model){return /\bblock\s*\d+\b/i.test(model)?'Block':/^(P6|T|X)/i.test(model)?'Tab':'Smart'}function output_(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON)}
